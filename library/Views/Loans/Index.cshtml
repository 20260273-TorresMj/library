@model IEnumerable<library.Models.LoanView>
@{
    ViewData["Title"] = "Loans & Returns";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <div>
        <h2 class="text-light fw-bold mb-1">Loans & Returns</h2>
        <p class="text-info font-monospace mb-0" style="font-size: 0.9rem;">&gt;_ @Model.Count() loans found</p>
    </div>
    <a asp-action="Borrow" class="btn btn-tech-primary px-4 py-2">+ Borrow a book</a>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card tech-card h-100 p-3">
                <div class="card-body d-flex flex-column p-2">
                    
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="tech-title text-truncate me-2">@Html.DisplayFor(modelItem => item.BookTitle)</h5>
                        <span class="tech-id-badge">#@Html.DisplayFor(modelItem => item.LoanId)</span>
                    </div>

                    <div class="mb-4 flex-grow-1">
                        <div class="mb-2">
                            <span class="tech-label">Member:</span> 
                            <span class="tech-value text-info">@Html.DisplayFor(modelItem => item.MemberName)</span>
                        </div>
                        <div class="mb-2">
                            <span class="tech-label">Status:</span> 
                            @if (item.Status == "Out") { <span class="badge bg-primary">Out</span> }
                            else if (item.Status == "Overdue") { <span class="badge bg-danger">Overdue</span> }
                            else { <span class="badge bg-success">Returned</span> }
                        </div>
                        <div>
                            <span class="tech-label">Loaned:</span> 
                            <span class="tech-value">@item.LoanedOn.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>

                    <hr class="border-secondary opacity-25 mb-3 mt-0">

                    <div class="d-flex gap-2">
                        @if (item.Status != "Returned")
                        {
                            <form asp-action="Return" asp-route-id="@item.LoanId" method="post" class="w-100">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-tech-outline w-100 fw-bold">Process Return</button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary w-100 disabled" disabled>Returned</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>