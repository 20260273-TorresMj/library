@model BorrowForm
@{
    ViewData["Title"] = "Borrow a book";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">

        <div class="mb-4 text-center">
            <h1 class="text-white fw-bold mb-1">Initialize Loan Protocol</h1>
            <p class="text-muted font-monospace">Assign a book to a member in the database.</p>
        </div>

        <form asp-action="Borrow" method="post" class="card p-4">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger font-monospace" role="alert"></div>

            <div class="mb-4">
                <label asp-for="MemberId" class="form-label text-info">Target Member</label>
                <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select form-select-lg">
                    <option value="">-- Select Member Record --</option>
                </select>
                <span asp-validation-for="MemberId" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="BookId" class="form-label text-info">Book Asset</label>
                <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select form-select-lg">
                    <option value="">-- Select Book Record --</option>
                </select>
                <span asp-validation-for="BookId" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="DaysAllowed" class="form-label text-info">Duration (Days)</label>
                <input asp-for="DaysAllowed" class="form-control form-control-lg font-monospace" type="number" />
                <span asp-validation-for="DaysAllowed" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-secondary">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Abort</a>
                <button type="submit" class="btn btn-primary px-5">Execute</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}