@model Book
@{
    ViewData["Title"] = "Add a Book";
}
<div class="lib-form">
    <h1>>_ Add a Book</h1>
    <form asp-action="Create" method="post">
        <div class="lib-field">
            <label asp-for="Title">Book Title</label>
            <input asp-for="Title" placeholder="e.g. The Great Gatsby" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="lib-field">
            <label asp-for="Category">Category</label>
            <select asp-for="Category">
                <option value="">(none)</option>
                <option>Classic</option>
                <option>Fiction</option>
                <option>Poetry</option>
                <option>Reference</option>
                <option>Textbook</option>
            </select>
        </div>
        <div class="lib-field">
            <label asp-for="Price">Price</label>
            <input asp-for="Price" type="number" step="0.01" placeholder="0.00" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="lib-actions">
            <button type="submit" class="lib-btn lib-btn-primary">Save Book</button>
            <a asp-action="Index" class="lib-btn lib-btn-ghost">Cancel</a>
        </div>
    </form>
</div>