@model List<Book>
@{
    ViewData["Title"] = "Books";
}

<div class="lib-toolbar">
    <div>
        <h2>Book Catalogue</h2>
        <p class="lib-count">>_ @Model.Count books found</p>
    </div>
    <a asp-action="Create" class="lib-btn lib-btn-primary">+ Add a book</a>
</div>

<div class="lib-grid">
    @foreach (var book in Model)
    {
        <div class="lib-box">
            <div class="d-flex justify-content-between align-items-start">
                <h3 class="lib-box-title">@book.Title</h3>
                <span class="lib-tag">#@book.BookId</span>
            </div>

            <p class="lib-box-meta">
                <strong>Category:</strong> @(book.Category ?? "—") <br />
                <strong>Price:</strong> @(book.Price?.ToString("N2") ?? "—")
            </p>

            <div class="lib-box-actions">
                <a asp-action="Edit" asp-route-id="@book.BookId" class="lib-btn lib-btn-ghost lib-btn-small">Edit</a>
                <a asp-action="Delete" asp-route-id="@book.BookId" class="lib-btn lib-btn-danger lib-btn-small">Delete</a>
            </div>
        </div>
    }
</div>