@model IEnumerable<library.Models.Book>
@{
    ViewData["Title"] = "Book Catalogue";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <div>
        <h2 class="text-light fw-bold mb-1">Book Catalogue</h2>
        <p class="text-info font-monospace mb-0" style="font-size: 0.9rem;">&gt;_ @Model.Count() books found</p>
    </div>
    <a asp-action="Create" class="btn btn-tech-primary px-4 py-2">+ Add a book</a>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card tech-card h-100 p-3">
                <div class="card-body d-flex flex-column p-2">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="tech-title text-truncate me-2" title="@item.Title">@Html.DisplayFor(modelItem => item.Title)</h5>
                        <span class="tech-id-badge">#@Html.DisplayFor(modelItem => item.BookId)</span>
                    </div>
                    <div class="mb-4 flex-grow-1">
                        <div class="mb-2">
                            <span class="tech-label">Category:</span> 
                            <span class="tech-value text-info">@(string.IsNullOrEmpty(item.Category) ? "—" : item.Category)</span>
                        </div>
                        <div>
                            <span class="tech-label">Price:</span> 
                            <span class="tech-value">@(item.Price.HasValue ? item.Price.Value.ToString("N2") : "—")</span>
                        </div>
                    </div>
                    <hr class="border-secondary opacity-25 mb-3 mt-0">
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-sm btn-tech-outline px-3">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-danger px-3">Delete</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>