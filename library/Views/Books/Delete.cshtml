@model Book
@{
    ViewData["Title"] = "Delete Book";
}
<div class="lib-danger-box">
    <h1>>_ Delete Book</h1>
    <p>Are you sure you want to permanently delete this book? This action cannot be undone.</p>

    <dl class="lib-detail-list">
        <dt>Title</dt>
        <dd>@Model.Title</dd>
        <dt>Category</dt>
        <dd>@(Model.Category ?? "—")</dd>
        <dt>Price</dt>
        <dd>@(Model.Price?.ToString("N2") ?? "—")</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.BookId" method="post">
        <div class="lib-actions" style="margin-top: 0;">
            <button type="submit" class="lib-btn lib-btn-danger">Confirm Delete</button>
            <a asp-action="Index" class="lib-btn lib-btn-ghost">Cancel</a>
        </div>
    </form>
</div>