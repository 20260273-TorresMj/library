@model Book
@{
    ViewData["Title"] = "Edit Book";
}
<div class="lib-form">
    <h1>>_ Edit Book</h1>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="BookId" />
        <div class="lib-field">
            <label asp-for="Title">Book Title</label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="lib-field">
            <label asp-for="Category">Category</label>
            <select asp-for="Category">
                <option value="">(none)</option>
                <option>Classic</option>
                <option>Fiction</option>
                <option>Poetry</option>
                <option>Reference</option>
                <option>Textbook</option>
            </select>
        </div>
        <div class="lib-field">
            <label asp-for="Price">Price</label>
            <input asp-for="Price" type="number" step="0.01" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="lib-actions">
            <button type="submit" class="lib-btn lib-btn-primary">Save Changes</button>
            <a asp-action="Index" class="lib-btn lib-btn-ghost">Cancel</a>
        </div>
    </form>
</div>