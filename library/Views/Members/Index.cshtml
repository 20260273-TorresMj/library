@model List<Member>
@{
    ViewData["Title"] = "Members";
}

<div class="lib-toolbar">
    <div>
        <h2>Members Directory</h2>
        <p class="lib-count">>_ @Model.Count members found</p>
    </div>
    <a asp-action="Create" class="lib-btn lib-btn-primary">+ Add a member</a>
</div>

<div class="lib-grid">
    @foreach (var member in Model)
    {
        <div class="lib-box">
            <div class="d-flex justify-content-between align-items-start">
                <h3 class="lib-box-title">@member.FullName</h3>
                <span class="lib-tag">#@member.MemberId</span>
            </div>

            <p class="lib-box-meta">
                <strong>Email:</strong> @(member.Email ?? "—") <br />
                <strong>Type:</strong> @member.MemberType
            </p>

            <div class="lib-box-actions">
                <a asp-action="Edit" asp-route-id="@member.MemberId" class="lib-btn lib-btn-ghost lib-btn-small">Edit</a>
                <a asp-action="Delete" asp-route-id="@member.MemberId" class="lib-btn lib-btn-danger lib-btn-small">Delete</a>
            </div>
        </div>
    }
</div>