@model IEnumerable<library.Models.Member>
@{
    ViewData["Title"] = "Members Directory";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <div>
        <h2 class="text-light fw-bold mb-1">Members Directory</h2>
        <p class="text-info font-monospace mb-0" style="font-size: 0.9rem;">&gt;_ @Model.Count() members found</p>
    </div>
    <a asp-action="Create" class="btn btn-tech-primary px-4 py-2">+ Add a member</a>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card tech-card h-100 p-3">
                <div class="card-body d-flex flex-column p-2">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="tech-title text-truncate me-2" title="@item.FullName">@Html.DisplayFor(modelItem => item.FullName)</h5>
                        <span class="tech-id-badge">#@Html.DisplayFor(modelItem => item.MemberId)</span>
                    </div>
                    <div class="mb-4 flex-grow-1">
                        <div class="mb-2">
                            <span class="tech-label">Type:</span> 
                            <span class="tech-value text-info">@Html.DisplayFor(modelItem => item.MemberType)</span>
                        </div>
                        <div>
                            <span class="tech-label">Email:</span> 
                            <span class="tech-value">@(string.IsNullOrEmpty(item.Email) ? "—" : item.Email)</span>
                        </div>
                    </div>
                    <hr class="border-secondary opacity-25 mb-3 mt-0">
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@item.MemberId" class="btn btn-sm btn-tech-outline px-3">Loans</a>
                        <a asp-action="Edit" asp-route-id="@item.MemberId" class="btn btn-sm btn-tech-outline px-3">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.MemberId" class="btn btn-sm btn-outline-danger px-3">Delete</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>