@model Member
@{
    ViewData["Title"] = "Edit Member";
}
<div class="lib-form">
    <h1>>_ Edit Member</h1>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="MemberId" />
        <div class="lib-field">
            <label asp-for="FullName">Full Name</label>
            <input asp-for="FullName" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="lib-field">
            <label asp-for="Email">Email Address</label>
            <input asp-for="Email" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="lib-field">
            <label asp-for="MemberType">Member Type</label>
            <select asp-for="MemberType">
                <option>Regular</option>
                <option>Student</option>
                <option>Faculty</option>
            </select>
            <span asp-validation-for="MemberType" class="text-danger"></span>
        </div>
        <div class="lib-actions">
            <button type="submit" class="lib-btn lib-btn-primary">Save Changes</button>
            <a asp-action="Index" class="lib-btn lib-btn-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}