@model Member
@{
    ViewData["Title"] = "Delete Member";
}
<div class="lib-danger-box">
    <h1>>@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}</h1>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    <p>Are you sure you want to permanently delete this member? Members with active loans cannot be deleted.</p>

    <dl class="lib-detail-list">
        <dt>Full Name</dt>
        <dd>@Model.FullName</dd>
        <dt>Email</dt>
        <dd>@(Model.Email ?? "—")</dd>
        <dt>Type</dt>
        <dd>@Model.MemberType</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.MemberId" method="post">
        <div class="lib-actions" style="margin-top: 0;">
            <button type="submit" class="lib-btn lib-btn-danger">Confirm Delete</button>
            <a asp-action="Index" class="lib-btn lib-btn-ghost">Cancel</a>
        </div>
    </form>
</div>