@{
    ViewData["Title"] = "Dashboard";
}

<!-- Hero Section -->
<div class="lib-hero">
    <h1>Welcome to the <span>Library System</span></h1>
    <p>A modern, high-performance management portal. Easily track books, manage members, and organize notes all in one place.</p>
</div>

<!-- Quick Actions Grid -->
<div class="lib-toolbar">
    <div>
        <h2>Quick Actions</h2>
        <p class="lib-count">>_ Select a module to begin</p>
    </div>
</div>

<div class="lib-grid mb-5">
    <!-- Books Card -->
    <div class="lib-box">
        <h3 class="lib-box-title">📖 Book Catalogue</h3>
        <p class="lib-box-meta">Browse, add, and update the library's book inventory. Keep track of titles, categories, and prices.</p>
        <div class="lib-box-actions">
            <a asp-controller="Books" asp-action="Index" class="lib-btn lib-btn-primary w-100">Manage Books</a>
        </div>
    </div>

    <!-- Members Card -->
    <div class="lib-box">
        <h3 class="lib-box-title">👥 Members Directory</h3>
        <p class="lib-box-meta">Manage student and faculty accounts. Register new members and update their contact information.</p>
        <div class="lib-box-actions">
            <a asp-controller="Members" asp-action="Index" class="lib-btn lib-btn-ghost w-100">Manage Members</a>
        </div>
    </div>

    <!-- Notepad Card -->
    <div class="lib-box">
        <h3 class="lib-box-title">📝 System Notepad</h3>
        <p class="lib-box-meta">Quickly jot down announcements, reminders, or internal notes for the library staff.</p>
        <div class="lib-box-actions">
            <a asp-controller="Notes" asp-action="Index" class="lib-btn lib-btn-ghost w-100">Open Notepad</a>
        </div>
    </div>
</div>

<!-- System Status Metrics -->
<div class="lib-toolbar mt-4">
    <div>
        <h2>System Status</h2>
        <p class="lib-count">>_ Live database overview</p>
    </div>
</div>

<div class="lib-grid" style="grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));">
    <!-- Metric 1 -->
    <div class="lib-box" style="align-items: center; justify-content: center; padding: 2rem 1rem;">
        <h1 style="color: var(--cyan-bright); font-size: 2.5rem; margin: 0; font-family: 'JetBrains Mono';">17</h1>
        <p class="lib-box-meta" style="margin-top: 0.5rem; padding: 0;">Books Loaded</p>
    </div>

    <!-- Metric 2 -->
    <div class="lib-box" style="align-items: center; justify-content: center; padding: 2rem 1rem;">
        <h1 style="color: var(--cyan-bright); font-size: 2.5rem; margin: 0; font-family: 'JetBrains Mono';">14</h1>
        <p class="lib-box-meta" style="margin-top: 0.5rem; padding: 0;">Active Members</p>
    </div>

    <!-- Metric 3 -->
    <div class="lib-box" style="align-items: center; justify-content: center; padding: 2rem 1rem;">
        <h1 style="color: var(--cyan-bright); font-size: 2.5rem; margin: 0; font-family: 'JetBrains Mono';">7</h1>
        <p class="lib-box-meta" style="margin-top: 0.5rem; padding: 0;">Notepad Entries</p>
    </div>

    <!-- Metric 4 -->
    <div class="lib-box" style="align-items: center; justify-content: center; padding: 2rem 1rem;">
        <h1 style="color: var(--success); font-size: 2.5rem; margin: 0; font-family: 'JetBrains Mono';">ONLINE</h1>
        <p class="lib-box-meta" style="margin-top: 0.5rem; padding: 0;">Database Status</p>
    </div>
</div>