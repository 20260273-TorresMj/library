@model Note
@{
    ViewData["Title"] = "Edit Note";
}
<div class="lib-form">
    <h1>>_ Edit Note</h1>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="NoteId" />
        <div class="lib-field">
            <label asp-for="Title">Note Title</label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="lib-field">
            <label asp-for="Body">Body Text</label>
            <textarea asp-for="Body" rows="5"></textarea>
            <span asp-validation-for="Body" class="text-danger"></span>
        </div>
        <div class="lib-actions">
            <button type="submit" class="lib-btn lib-btn-primary">Save Changes</button>
            <a asp-action="Index" class="lib-btn lib-btn-ghost">Cancel</a>
        </div>
    </form>
</div>